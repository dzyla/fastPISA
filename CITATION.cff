    title: "Inference of macromolecular assemblies from crystalline state"
    authors:
      - family-names: "Krissinel"
        given-names: "Evgeny"
      - family-names: "Henrick"
        given-names: "Kim"
    journal: "Journal of Molecular Biology"
    volume: 372
    start: 774
    end: 797
    year: 2007
    doi: "10.1016/j.jmb.2007.05.022"
