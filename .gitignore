# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.eggs/

# Virtual environments
.venv/
venv/
env/

# IDE / editor
.vscode/
.idea/
*.swp

# fastPISA runtime outputs
*.pdb_tmp/
output/
out/
*.xml
# ...but `output/` above also matches the SOURCE package fastpisa/output/, which is why
# it was never committed: `from fastpisa.api import PISAInterfaceAnalyzer` then fails with
# ModuleNotFoundError from any clean clone, because pipeline.py imports
# fastpisa.output.json_output. Re-include the package explicitly.
!fastpisa/output/
!fastpisa/output/*.py

# OS
.DS_Store

# Testing / notebooks
.ipynb_checkpoints/

# Large assembly-coordinate cache (refetched on demand)
tests/data/reference/assemblies/


# Large PISA reference cache for the sampled calibration benchmark (~100 MB
# of EBI PISA XML + RCSB coordinates; refetch with
# examples/build_calibration_set.py). The 36 legacy benchmark entries were
# committed before this rule and stay tracked -- git ignores .gitignore for
# files already in the index -- so tests/test_vs_pdbe_pisa.py still runs
# offline from a clean clone. What reproduces the *fits* is the distilled
# feature table in tests/data/calibration/, which is small and committed.
tests/data/reference/*.pisa.xml.gz
tests/data/reference/pdb/

# Residue-level calibration table (local, ~10-20 MB; rebuild with
# examples/extract_calibration_features.py --residues)
tests/data/calibration/residues.json.gz
